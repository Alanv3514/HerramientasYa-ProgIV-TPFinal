# Copiá este archivo como .env y completá los valores. El .env nunca se sube (RNF-02).

# Base de datos
POSTGRES_USER=herramientas
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=herramientas
# postgresql con Docker; sqlite para desarrollo rápido sin Docker
DB_ENGINE=postgresql
DATABASE_URL=postgresql+psycopg://herramientas:cambiame@db:5432/herramientas

# Autenticación (RNF-02). Generá una clave larga, por ejemplo:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=30

# Frontend
CORS_ORIGIN=http://localhost:5174
VITE_API_URL=http://localhost:8000

# Datos de prueba para la demo
SEED_DEMO=true
