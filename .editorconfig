root = true

# UTF-8 sin BOM y LF: evita acentos rotos (mojibake) al editar desde Windows
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Python: 4 espacios y líneas de hasta 120, como el ruff de la cátedra
[*.py]
indent_size = 4
max_line_length = 120

# Markdown: dos espacios al final de una línea son un salto de línea
[*.md]
trim_trailing_whitespace = false
